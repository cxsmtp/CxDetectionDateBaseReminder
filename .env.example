# =============================================================================
# CxMissionZero — sample settings file (.env)
# =============================================================================
# Fill in what you have, leave the rest blank, then either:
#
#   A. Upload it: Settings → "Quick setup from a .env file". Section 1 takes
#      effect at once; each connection is checked straight away, and one that
#      does not work is rolled back to the last known good settings.
#      Blank lines never overwrite a working setting.
#
#   B. Start the container with it (sections 1 and 2):
#      podman run -d --name mission-zero -p 3000:3000 -v mission-zero-data:/data --env-file mission-zero.env ghcr.io/cxsmtp/cxdetectiondatebasereminder:latest
#
# Keep the filled-in file private: it holds your API key and mail password.
# Lines starting with # are comments. Values need no quotes.

# -----------------------------------------------------------------------------
# 1. Connections — applied when uploaded on the Settings page
#    (Checkmarx One, mail server, report address, GitHub)
# -----------------------------------------------------------------------------

# Checkmarx One API key the server uses for everyone who signs in with a
# password, for triage from emailed reports, and for automatic reminders.
# Checkmarx One → Settings → Identity and Access Management → API Keys.
# The tenant, IAM and API URLs are worked out from the key.
CX_API_KEY=

# Only for single-tenant / on-prem Checkmarx One, where they cannot be
# worked out from the key. Leave blank on the multi-tenant cloud.
#   CX_BASE_URL example: https://eu.ast.checkmarx.net
#   CX_IAM_URL  example: https://eu.iam.checkmarx.net
#   CX_TENANT   example: acme
CX_BASE_URL=
CX_IAM_URL=
CX_TENANT=

# Your mail server, used to send reminders and reports.
#   Office 365: smtp.office365.com, port 587, SMTP_SECURE=false
#   Gmail:      smtp.gmail.com,     port 587, SMTP_SECURE=false, and an App
#               Password (https://myaccount.google.com/apppasswords) as SMTP_PASS
#   Port 465 needs SMTP_SECURE=true; ports 25, 587 and 2525 need false.
#   A blank value keeps what is set now, so you can upload only what changed.
SMTP_HOST=
# Usually 587.
SMTP_PORT=
# true for port 465, false for 587 / 25 / 2525.
SMTP_SECURE=
# true when the server needs a user name and password (most do).
SMTP_REQUIRE_AUTH=
# false only for an internal relay with a self-signed certificate.
SMTP_REJECT_UNAUTHORIZED=
SMTP_USER=
SMTP_PASS=
# Sender shown on reminders. Blank: SMTP_USER.
SMTP_FROM=
SMTP_FROM_NAME=

# The address people's browsers use to reach this server, put into every
# emailed report so readers can triage and remediate from it.
# Use the HTTPS name behind your reverse proxy, e.g. https://mission-zero.company.com
REPORT_SERVER_URL=

# Beta features (Beta page: email the authors of vulnerable code, match GitHub
# usernames to email addresses). A GitHub token with read access to your
# repositories: GitHub → Settings → Developer settings → Personal access
# tokens (fine-grained: Contents and Metadata read-only).
# GITHUB_API_URL only for GitHub Enterprise, e.g. https://github.company.com/api/v3
GITHUB_TOKEN=
GITHUB_API_URL=
GITHUB_ORG=

# -----------------------------------------------------------------------------
# 2. Start-up only — read when the container starts (way B); listed as
#    "not applied" when uploaded. Remove the leading # to use one.
# -----------------------------------------------------------------------------

# Time zone for automatic reminders and dates in emails. Default UTC.
# TZ=Asia/Dubai

# The first administrator, created on first start; the password is printed in
# the container log once (podman logs mission-zero). Default email:
# admin@mission-zero.local. Lost it: podman exec mission-zero node scripts/reset-admin.mjs
# ADMIN_EMAIL=appsec-lead@company.com
# ADMIN_PASSWORD=

# HTTPS served by CxMissionZero itself (docs/https-and-hosting.md). Easiest: an
# Admin runs it from Settings → HTTPS (upload the certificate, test, switch).
# HTTPS only sets how it starts: on (the image's default: HTTPS only, your
# certificate when given, else a self-signed one), off (plain http: your own
# machine, or behind a reverse proxy that does HTTPS), or both (side by side on
# the same port). Once changed on the Settings page, the page's choice wins. Mount the certificate folder (-v C:\mission-zero\certs:/certs:ro)
# and name the files, or use a .pfx. HTTP_REDIRECT_PORT also listens for plain
# http and sends it to https.
# HTTPS=on
# TLS_CERT_FILE=/certs/server.crt
# TLS_KEY_FILE=/certs/server.key
# TLS_PFX_FILE=/certs/server.pfx
# TLS_PFX_PASSPHRASE=
# TLS_SELF_SIGNED=1
# HTTP_REDIRECT_PORT=8080
# Behind a reverse proxy that is not on this machine or a private network:
# its address, so its X-Forwarded-* headers are believed.
# TRUST_PROXY=10.20.0.15

# Signed-in sessions end after this many idle minutes. Default 480 (8 hours).
# SESSION_IDLE_MINUTES=480
# A signed-in person's fetched data is saved at once, then at most every this
# many seconds while it keeps changing. Default 30.
# SESSION_SAVE_SECONDS=30

# Updates (docs/updating.md): how long requests in progress may finish when
# the container stops (keep it below the stop timeout, 10 s by default), and
# how long a new server waits for the old one to let go of /data.
# SHUTDOWN_DRAIN_SECONDS=8
# INSTANCE_LOCK_WAIT_SECONDS=45

# Scheduled backups of /data (one file each). See docs/audit-and-backup.md.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# BACKUP_PASSPHRASE=
# BACKUP_DIR=/data/backups

# Memory for the server: about two-thirds of the container's memory limit.
# For --memory 3g (up to 3000 people at once, see docs/performance.md):
# NODE_OPTIONS=--max-old-space-size=2048

# Company CA certificate (mounted into the container) when a proxy inspects
# TLS to Checkmarx One or your mail server.
# NODE_EXTRA_CA_CERTS=/certs/company-ca.pem

# Tuning: calls to Checkmarx One at once (raise only if your tenant allows),
# projects read at once by one fetch, pages of one big project read at once,
# how long a project someone just fetched is reused by the next fetch (0: off),
# and report requests handled at once before readers are asked to retry.
# CX_MAX_CONCURRENCY=24
# CX_FETCH_CONCURRENCY=10
# CX_PAGES_AT_ONCE=4
# CX_FETCH_CACHE_SECONDS=120

# Compress replies of at least this many KB (the page, the fetch stream,
# downloads). off when your reverse proxy compresses.
# HTTP_COMPRESSION=on
# HTTP_COMPRESSION_MIN_KB=32
# RELAY_MAX_IN_FLIGHT=300

# Where findings are read from. "scan-results" for tenants without the risks
# service; CX_RISKS_PATH=/api/risks/ai-insights adds AI Triage status.
# CX_RISK_SOURCE=risk-insights
# CX_RISKS_PATH=/api/risks/

# Outside a container only (the image sets these): listening address and
# port, and the folder that holds all state.
# HOST=127.0.0.1
# PORT=3000
# DATA_DIR=/var/lib/mission-zero
