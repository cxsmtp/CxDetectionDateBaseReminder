# ---------------------------------------------------------------------------
# There is almost nothing to configure here.
# ---------------------------------------------------------------------------
# The Checkmarx API key is pasted into the portal's connect screen, and SMTP,
# recipients and the mail template are configured on the Settings page and
# persisted to data/settings.json (gitignored, written 0600).
#
# Everything below is optional.

# Optional bootstrap for headless / kiosk deployments where nobody is there to
# paste a key. Leave unset for normal use.
# CX_API_KEY=

# Connection overrides for single-tenant / on-prem deployments, where the
# regional URL convention does not hold. Also editable under "Advanced" on the
# connect screen.
# CX_BASE_URL=
# CX_IAM_URL=
# CX_TENANT=

# How long an idle connection stays open before the operator must reconnect.
# SESSION_IDLE_MINUTES=480

# Where administrator settings are stored.
# SETTINGS_FILE=./data/settings.json

# ---------------------------------------------------------------------------
# Risks API
# ---------------------------------------------------------------------------
# Default path for GET /api/risks/ (projectId is sent as a query parameter).
# Also settable on the Settings page, which overrides this.
# CX_RISKS_PATH=/api/risks/
#
# To pull AI triage and remediation status alongside each finding, point this
# at the AI insights variant instead:
# CX_RISKS_PATH=/api/risks/ai-insights

# Risk source: "risk-insights" (default, uses CX_RISKS_PATH) or "scan-results"
# for tenants without the risks service, which reads firstFoundAt from the
# latest completed scan's results instead.
# CX_RISK_SOURCE=risk-insights

# Probe alternative paths when the configured one is rejected.
# CX_RISKS_AUTODISCOVER=true

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1
# CX_FETCH_CONCURRENCY=5
