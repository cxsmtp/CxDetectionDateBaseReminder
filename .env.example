# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# There is NO credential setting here by design.  Open the portal in a browser
# and paste your Checkmarx One API key into the connect screen -- the tenant,
# region, IAM URL and API URL are all detected from the key itself.  The key is
# held in the server's memory for the session only; it is never written to disk
# and never sent back to the browser.
#
# CX_API_KEY is supported ONLY as an optional bootstrap for headless / kiosk
# deployments where nobody is there to paste a key.  It connects a shared
# session at startup that every visitor uses.  Leave it unset for normal use.
# CX_API_KEY=

# Optional connection overrides, applied to every connection.  Set these only
# for single-tenant / on-prem deployments where the regional URL convention
# does not hold -- the same values are also editable under "Advanced" on the
# connect screen.
# CX_BASE_URL=
# CX_IAM_URL=
# CX_TENANT=

# How long an idle connection stays open before the operator must reconnect.
# SESSION_IDLE_MINUTES=480

# ---------------------------------------------------------------------------
# Risk Insights API
# ---------------------------------------------------------------------------
# Path template used to pull risks with AI insights for a single project.
# "{projectId}" is substituted at call time.  The default matches the
# "Retrieve Risks with AI Insights" operation of the Risk Management service.
# CX_RISKS_PATH=/api/risk-management/risks/{projectId}
# CX_RISKS_METHOD=GET

# Risk source: "risk-insights" (default) or "scan-results".
# "scan-results" is a fallback that derives first-detection dates from the
# /api/results firstFoundAt field of each project's latest scan.  Use it if
# the Risk Management service is not enabled on your tenant.
# CX_RISK_SOURCE=risk-insights

# Allow the client to probe a short list of alternative Risk Insights paths
# when the configured one returns 404, and remember whichever answers.
# CX_RISKS_AUTODISCOVER=true

# ---------------------------------------------------------------------------
# Feedback App (email) delivery
# ---------------------------------------------------------------------------
# CX_FEEDBACK_APPS_PATH=/api/feedbackapps
# CX_FEEDBACK_APP_TRIGGER_PATH=/api/feedbackapps/{appId}/notify

# Delivery mode:
#   auto     - try the Feedback App trigger API, fall back to SMTP (default)
#   feedback - Feedback App trigger API only
#   smtp     - SMTP only, using the recipients configured on the Feedback App
# REMINDER_DELIVERY_MODE=auto

# SMTP settings, used by the "smtp"/"auto" delivery modes.  The recipient list
# still comes from the selected Feedback App -- SMTP is only the transport.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Checkmarx Reminders <noreply@example.com>"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1
# CX_FETCH_CONCURRENCY=5
