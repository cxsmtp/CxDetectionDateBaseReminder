# ---------------------------------------------------------------------------
# There is almost nothing to configure here.
# ---------------------------------------------------------------------------
# The Checkmarx API key is pasted into the portal's connect screen, and SMTP,
# recipients and the mail template are configured on the Settings page and
# persisted to settings.json in the state folder (DATA_DIR, written 0600).
#
# Everything below is optional.

# The server's Checkmarx One integration key, used by everyone who signs in with
# a password, by report triage and by automation. An Admin can store one from
# Settings → Checkmarx One instead. People still have to sign in.
# CX_API_KEY=

# First administrator for unattended installs (otherwise a one-time setup code is
# printed in the log at first start). They choose a new password at first sign-in.
# ADMIN_EMAIL=appsec-lead@company.com
# ADMIN_PASSWORD=

# Connection overrides for single-tenant / on-prem deployments, where the
# regional URL convention does not hold. Also editable under "Advanced" on the
# connect screen.
# CX_BASE_URL=
# CX_IAM_URL=
# CX_TENANT=

# The reminder server address put into every HTML report: how readers'
# browsers reach this server to triage from the report. The Settings page
# overrides it. Blank: the address the dashboard is open on.
# REPORT_SERVER_URL=https://cx-reminder.corp.example

# How long an idle connection stays open before the operator must reconnect.
# SESSION_IDLE_MINUTES=480

# The state folder: settings, credit ledger and allocations, tracked reports,
# the audit log and signing keys. Keep it OUTSIDE the project folder so a
# redeploy never touches it. Default: ~/.mission-zero of the service user.
# DATA_DIR=/var/lib/mission-zero
# (Older setups: SETTINGS_FILE=/path/settings.json uses that file's folder.)

# Backups of the state folder, one file each (see docs/audit-and-backup.md).
# Put BACKUP_DIR on another disk or a network share: default <DATA_DIR>/backups.
# BACKUP_DIR=/mnt/backups/mission-zero
# BACKUP_INTERVAL_HOURS=24      # 0 turns scheduled backups off
# BACKUP_KEEP=14                # newest backups kept in BACKUP_DIR
# BACKUP_PASSPHRASE=            # encrypts backups (AES-256-GCM); needed to restore

# ---------------------------------------------------------------------------
# Risks API
# ---------------------------------------------------------------------------
# Default path for GET /api/risks/ (projectId is sent as a query parameter).
# Also settable on the Settings page, which overrides this.
# CX_RISKS_PATH=/api/risks/
#
# To pull AI triage and remediation status alongside each finding, point this
# at the AI insights variant instead:
# CX_RISKS_PATH=/api/risks/ai-insights

# Risk source: "risk-insights" (default, uses CX_RISKS_PATH) or "scan-results"
# for tenants without the risks service, which reads firstFoundAt from the
# latest completed scan's results instead.
# CX_RISK_SOURCE=risk-insights

# Probe alternative paths when the configured one is rejected.
# CX_RISKS_AUTODISCOVER=true

# ---------------------------------------------------------------------------
# SMTP Configuration (Email sending)
# ---------------------------------------------------------------------------
# For headless/automated deployments, configure SMTP to send reminder emails.
# If not set, you'll configure SMTP on the Settings page in the UI.
#
# Gmail example (recommended for testing):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password-here
#
# Note: For Gmail, use an "App Password" (not your regular password):
# https://myaccount.google.com/apppasswords
# 1. Go to that link
# 2. Select "Mail" and "Windows Computer" (or your device)
# 3. Copy the 16-character password
# 4. Paste it as SMTP_PASS value below

# SMTP Server hostname (Gmail: smtp.gmail.com)
# SMTP_HOST=smtp.gmail.com

# SMTP Server port (Gmail: 587 for TLS, 465 for SSL)
# SMTP_PORT=587

# Use TLS encryption (Gmail: false for port 587, true for port 465)
# SMTP_SECURE=false

# Email account that sends reminders (Gmail: your full email address)
# SMTP_USER=your-email@gmail.com

# Email account password (Gmail: use 16-char App Password)
# SMTP_PASS=your-app-password-here

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1
# CX_FETCH_CONCURRENCY=5
