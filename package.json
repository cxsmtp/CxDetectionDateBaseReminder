{
  "name": "cx-detection-date-reminder",
  "version": "1.0.5",
  "private": true,
  "description": "Utility that lists Checkmarx One projects with vulnerability first-detection dates and sends ageing reminders through a configured CxONE Feedback App.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "reset-admin": "node scripts/reset-admin.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nodemailer": "^10.0.12"
  },
  "overrides": {
    "debug": "^4.4.3"
  }
}
